// Prisma Database Schema for SenseiBook Martial Arts Academy Management
// Supports PostgreSQL (Supabase / Neon / AWS RDS)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  SENSEI
  STAFF
}

enum DojoStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BeltRank {
  WHITE_BELT
  YELLOW_BELT
  ORANGE_BELT
  GREEN_BELT
  BLUE_BELT
  PURPLE_BELT
  BROWN_BELT
  BLACK_BELT_1ST_DAN
  BLACK_BELT_2ND_DAN
  BLACK_BELT_3RD_DAN
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentMethod {
  UPI_GPAY
  CASH
  CARD_POS
  BANK_TRANSFER
  NET_BANKING
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole   @default(SENSEI)
  avatarUrl    String?
  dojoId       String?
  dojo         Dojo?      @relation(fields: [dojoId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  markedAttendances Attendance[]
  recordedPayments  Payment[]

  @@map("users")
}

model Dojo {
  id             String       @id @default(cuid())
  name           String
  logoUrl        String?
  instructorName String
  address        String
  phone          String
  email          String?
  status         DojoStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users          User[]
  batches        Batch[]
  students       Student[]
  feePlans       FeePlan[]
  activities     ActivityLog[]

  @@map("dojos")
}

model Batch {
  id              String       @id @default(cuid())
  dojoId          String
  dojo            Dojo         @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  name            String       // e.g. "Kids Beginner", "Adults Kumite"
  scheduleDays    String[]     // e.g. ["Mon", "Wed", "Fri"]
  startTime       String       // e.g. "17:00"
  durationMinutes Int          @default(60)
  maxCapacity     Int          @default(25)
  level           String       @default("Beginner")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  students        Student[]
  attendances     Attendance[]

  @@map("batches")
}

model FeePlan {
  id              String       @id @default(cuid())
  dojoId          String?
  dojo            Dojo?        @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  name            String       // e.g. "Standard Monthly Plan"
  durationMonths  Int          @default(1)
  billingCycle    BillingCycle @default(MONTHLY)
  tuitionFee      Decimal      @db.Decimal(10, 2)
  registrationFee Decimal      @default(0.00) @db.Decimal(10, 2)
  dueDayOfMonth   Int          @default(5) // 1 to 28
  activeMonths    Int[]        // [1, 2, 3, ... 12]
  isDefault       Boolean      @default(false)
  currency        String       @default("₹")
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  students        Student[]

  @@map("fee_plans")
}

model Student {
  id              String        @id @default(cuid())
  fullName        String
  photoUrl        String?
  dob             DateTime?
  joinDate        DateTime      @default(now())
  email           String?
  phone           String
  whatsapp        String?
  parentName      String?
  parentPhone     String?

  dojoId          String
  dojo            Dojo          @relation(fields: [dojoId], references: [id], onDelete: Restrict)

  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id], onDelete: Restrict)

  beltRank        BeltRank      @default(WHITE_BELT)

  tuitionPlanId   String
  tuitionPlan     FeePlan       @relation(fields: [tuitionPlanId], references: [id], onDelete: Restrict)

  hasRegistrationFee Boolean    @default(true)
  status          StudentStatus @default(ACTIVE)
  feeStatus       FeeStatus     @default(PENDING)
  dueAmount       Decimal       @default(0.00) @db.Decimal(10, 2)
  lastPaidDate    DateTime?

  medicalNotes    String?
  experience      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attendances     Attendance[]
  payments        Payment[]

  @@index([dojoId])
  @@index([batchId])
  @@index([feeStatus])
  @@index([beltRank])
  @@map("students")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  markedById String?
  markedBy   User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@unique([studentId, batchId, date])
  @@index([date])
  @@index([batchId])
  @@map("attendances")
}

model Payment {
  id             String        @id @default(cuid())
  receiptNumber  String        @unique // e.g. "SB-REC-2026-001"
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(UPI_GPAY)
  referenceId    String?       // UPI transaction ID or POS ref
  periodMonth    Int?          // 1-12
  periodYear     Int?          // 2026
  status         String        @default("SUCCESS")
  notes          String?
  recordedById   String?
  recordedBy     User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  whatsappSent   Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@map("payments")
}

model ActivityLog {
  id        String   @id @default(cuid())
  dojoId    String?
  dojo      Dojo?    @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  type      String   // "attendance" | "payment" | "student" | "general"
  text      String
  icon      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([dojoId])
  @@index([createdAt])
  @@map("activity_logs")
}
