# Firebase Configuration Keys
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-dojo-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-dojo-app
VITE_FIREBASE_STORAGE_BUCKET=your-dojo-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional WhatsApp API (Twilio / Meta Cloud API)
VITE_WHATSAPP_ENABLED=true
